{
  "name": "pi-enhanced",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Opinionated Pi package: multi-agent harness extensions, skills, and themes",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test extensions/**/*.test.ts",
    "smoke:package": "node scripts/package-smoke.mjs",
    "verify": "npm run check && npm test && npm run smoke:package"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@earendil-works/pi-tui": "0.82.1",
    "@types/node": "^24.13.3",
    "typebox": "1.1.38",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
